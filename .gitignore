# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Data (cookiecutter-data-science layout; see src/config.py).
# Raw TEJ exports (~640 MB) are supplied locally; only data/raw/TEJ/data.yaml
# is tracked. interim/processed/external are regenerable; keep the .gitkeep.
/data/raw/**/*.csv
/data/interim/*
/data/processed/*
/data/external/*
!/data/*/.gitkeep

# Trained runs + session logs (regenerable, large)
/models/
/logs/

# External reference clones (qlib, course repo) — kept locally, untracked.
# See README "Prerequisites" for the clone URLs.
thirdparty/

# Local scratch / experiment outputs
*.log
*.pt
*.ckpt

# Jupyter
.ipynb_checkpoints/

# Editor / IDE / agent tooling
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage / testing
.coverage
.pytest_cache/
htmlcov/

# mypy / ruff / type checkers
.mypy_cache/
.ruff_cache/

# Local config overrides + credentials
.env
.env.local

